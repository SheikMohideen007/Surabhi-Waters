rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Website enquiries: anyone may submit one, nobody may read them from the
    // client. Reading is done from the Firebase console or a trusted backend
    // using the Admin SDK, which bypasses these rules.
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidInquiry(data) {
    return data.keys().hasOnly([
             'name', 'company', 'email', 'phone', 'location',
             'requirement', 'message', 'source', 'createdAt'
           ])
           && data.keys().hasAll(['name', 'email', 'phone', 'requirement', 'message'])
           && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
           && data.email is string && data.email.matches('.+@.+\\..+') && data.email.size() <= 200
           && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
           && data.requirement is string && data.requirement.size() <= 120
           && data.message is string && data.message.size() >= 15 && data.message.size() <= 5000;
  }
}
