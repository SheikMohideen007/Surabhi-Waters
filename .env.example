# ---------------------------------------------------------------------------
# Public site URL — used for canonical URLs, sitemap, robots and OG metadata.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.surabhiwaters.com

# ---------------------------------------------------------------------------
# Firebase web app configuration.
#
# Copy these from Firebase console → Project settings → Your apps → Web app.
# These values are public by design (they identify the project, they do not
# grant access); access is controlled by Firestore security rules.
#
# Leave them blank and the contact form falls back to opening a pre-filled
# email to the company address instead of writing to Firestore.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Admin console at /admin
# ---------------------------------------------------------------------------
ADMIN_EMAIL=mohanbabu.admin@surabhiwaters.com
ADMIN_PASSWORD=admin@1234
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Enable Email/Password in Firebase Authentication and create the same
# ADMIN_EMAIL / ADMIN_PASSWORD user so /admin can read enquiries on Cloudflare.
